      }
    },
    { "atMs": 4500, "op": "tick" },
    { "atMs": 5000, "op": "event", "event": { "type": "text", "delta": "文件。" } },
    {
      "atMs": 5100,
      "op": "event",
      "event": {
        "type": "end",
        "sessionId": "sess-abc",
